# ── Database (Supabase) ──────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Use port 6543 for Transaction mode (Supabase pooler)

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# ── Backend (NestJS) ─────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000   # used for CORS

# ── Frontend (Next.js) ───────────────────────────────
# NEXT_PUBLIC_ prefix = exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Production overrides (set in Render / Vercel) ────
# DATABASE_URL=<supabase-connection-string>
# NEXT_PUBLIC_API_URL=<render-backend-url>